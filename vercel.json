{
  "version": 2,
  "functions": {
    "api/server.py": {
      "maxDuration": 60,
      "memory": 512
    }
  },
  "routes": [
    {
      "src": "/api/candidates/refresh-stream",
      "dest": "/api/server",
      "headers": {
        "Cache-Control": "no-cache",
        "X-Accel-Buffering": "no"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/api/server"
    }
  ]
}
